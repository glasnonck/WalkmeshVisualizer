<Window x:Class="WalkmeshVisualizerWpf.Views.PathSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WalkmeshVisualizerWpf.Views"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="PathSettingsWindow"
        Width="600" d:Width="450"
        SizeToContent="Height">
    <Window.Resources>
        <Style TargetType="ListViewItem" x:Key="BaseItemStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Image">
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Source" Value="/Resources/Icons/FolderIcon.png" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Grid.ColumnSpan" Value="8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Height" Value="66" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Grid.ColumnSpan" Value="8" />
            <Setter Property="Margin" Value="4,0,4,4" />
            <Setter Property="Height" Value="2" />
            <Setter Property="BorderBrush" Value="#707070" />
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Grid.ColumnSpan" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--Header-->
        <Label Grid.ColumnSpan="8"
               HorizontalContentAlignment="Center"
               FontSize="24" FontWeight="Bold"
               Content="Path Settings" />
        <Button Click="FolderButton_Click">
            <StackPanel>
                <Image />
                <TextBlock Text="Browse" Margin="2,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>


        <!--K1 Setting-->
        <Label Grid.Row="1" Content="KotOR 1 Path:" />
        <TextBox Grid.Row="1" Text="{Binding Kotor1Path}" />

        <!--K1 Suggestions-->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Margin="32,0"
                       FontSize="12" FontStyle="Italic"
                       Text="Installed games: (double-click to select)"
                       />
            <ListView Grid.Row="2" Tag="Kotor1"
                      ItemsSource="{Binding Kotor1SuggestedPaths}"
                      d:ItemsSource="{d:SampleData}"
                      MouseDoubleClick="ListView_DoubleClick" />
        </DockPanel>
        
        <!--Separator-->
        <Separator Grid.Row="3" />

        <!--K2 Setting-->
        <Label Grid.Row="4" Content="KotOR 2 Path:" />
        <TextBox Grid.Row="4" Text="{Binding Kotor2Path}" />
        <!--<Button Grid.Row="4" Tag="Kotor2" Click="FolderButton_Click">
            <Image />
        </Button>-->

        <!--K2 Suggestions-->
        <DockPanel Grid.Row="5">
            <TextBlock DockPanel.Dock="Top" Margin="32,0"
                       FontSize="12" FontStyle="Italic"
                       Text="Installed games: (double-click to select)"
                       />
            <ListView Grid.Row="2" Tag="Kotor2"
                      ItemsSource="{Binding Kotor2SuggestedPaths}"
                      d:ItemsSource="{d:SampleData}"
                      MouseDoubleClick="ListView_DoubleClick" />
        </DockPanel>
        
        <!--Ok/Cancel Buttons-->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="60" />
                    <Setter Property="Margin" Value="10,0,4,4" />
                </Style>
            </StackPanel.Resources>
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
