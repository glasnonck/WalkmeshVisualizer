<UserControl x:Class="WalkmeshVisualizerWpf.UserControls.Globals.FindGlobalsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WalkmeshVisualizerWpf.UserControls.Globals"
             mc:Ignorable="d" d:Background="White" d:Height="400"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid x:Name="globalsPanel" Grid.Column="1" d:MinWidth="240" d:Width="240" Margin="4,0,0,0">
        <!--Hiding the control should be handled in the VisualizerWindow--> 
        <!--<Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowGlobalsPanel}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>-->
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" x:Name="rowGlobalsFind" />
            <RowDefinition Height="Auto" x:Name="rowGlobalsReadWrite" />
        </Grid.RowDefinitions>
        
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBlock" x:Key="tbHeader">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style TargetType="TextBlock" x:Key="tbHighlight">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="Black" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding GlobalsFindSelectedItem.HasChanged}" Value="True">
                        <DataTrigger.Setters>
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger.Setters>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <DataTemplate x:Key="dtAddWatch">
                <Grid Margin="-4">
                    <Button Margin="0" Padding="0" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        Click="ToggleGlobalWatch_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Lavender" />
                                            <Setter Property="BorderBrush" Value="MediumSlateBlue" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image Margin="0" Width="14" Source="/Resources/Icons/AddIcon.png" Visibility="Collapsed">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWatched}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Image Margin="0" Width="14" Source="/Resources/Icons/RemoveIcon.png" Visibility="Visible">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWatched}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
            </DataTemplate>
            <Style TargetType="ListViewItem" x:Key="BaseItemStyle">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Style TargetType="ListViewItem" x:Key="FindGlobalStyle" BasedOn="{StaticResource BaseItemStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasChanged}" Value="True">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- Find Globals -->
        <Grid Grid.Row="0" x:Name="gridGlobalsFind">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Find" Style="{StaticResource tbHeader}" />

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Left" Text="Filter:" />
                <Button DockPanel.Dock="Right" Margin="4,0,0,4" Click="ClearGlobalsFindFilter_Click">
                    <Image Height="14" Width="14" Source="/Resources/Icons/Backspace.png" />
                </Button>
                <TextBox x:Name="txtGlobalsFindFilter" TextChanged="TxtGlobalsFindFilter_TextChanged" d:Text="filter" />
            </DockPanel>

            <ListView Grid.Row="2" x:Name="lvGlobalsFind"
                                    ItemsSource="{Binding KotorFindGlobals}"
                                    ItemContainerStyle="{StaticResource FindGlobalStyle}"
                                    SelectedItem="{Binding GlobalsFindSelectedItem, Mode=TwoWay}"
                                    SelectionChanged="LvGlobalsFind_SelectionChanged"
                                    d:ItemsSource="{d:SampleData}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="22" CellTemplate="{StaticResource dtAddWatch}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Add" Content="" />
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="28">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0" IsChecked="{Binding DoPopupOnChange, Mode=TwoWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                            <GridViewColumnHeader Click="LvGlobalsFind_ColumnHeader_Click" Tag="DoPopupOnChange" Content="Pop"
                                                              ToolTip="Show in-game popup when value changes." />
                        </GridViewColumn>
                        <GridViewColumn Width="60" DisplayMemberBinding="{Binding Type}">
                            <GridViewColumnHeader Click="LvGlobalsFind_ColumnHeader_Click" Tag="Type" Content="Type" />
                        </GridViewColumn>
                        <GridViewColumn Width="140" DisplayMemberBinding="{Binding Name}">
                            <GridViewColumnHeader Click="LvGlobalsFind_ColumnHeader_Click" Tag="Name" Content="Name" />
                        </GridViewColumn>
                        <GridViewColumn Width="100" DisplayMemberBinding="{Binding Value}">
                            <GridViewColumnHeader Click="LvGlobalsFind_ColumnHeader_Click" Tag="Value" Content="Value" />
                        </GridViewColumn>
                        <GridViewColumn Width="100" DisplayMemberBinding="{Binding LastReadAt, StringFormat=HH:mm:ss}">
                            <GridViewColumnHeader Click="LvGlobalsFind_ColumnHeader_Click" Tag="LastReadAt" Content="Read At" />
                        </GridViewColumn>
                        <GridViewColumn Width="100" DisplayMemberBinding="{Binding LastChangeAt, StringFormat=HH:mm:ss}">
                            <GridViewColumnHeader Click="LvGlobalsFind_ColumnHeader_Click" Tag="LastChangeAt" Content="Change At" />
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="2" Margin="8,24,8,0" TextWrapping="Wrap" Visibility="Collapsed" Text="Select a game to populate globals.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KotorFindGlobals.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Read / Write Globals -->
        <Grid Grid.Row="1" x:Name="gridGlobalsReadWrite">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ToggleButton Margin="0,0,4,4" Padding="0" Height="22" Width="22"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      IsChecked="{Binding GlobalsFindSelectedItem.DoPopupOnChange, Mode=TwoWay}"
                                      ToolTip="Show in-game popup when value changes.">
                <Image Height="20" Source="/Resources/Icons/PopupIcon.png" />
            </ToggleButton>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Read / Write" Style="{StaticResource tbHeader}" />
            <ToggleButton Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" Padding="0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding GM.DoGlobalReadAutoRefresh, Mode=TwoWay}"
                                      ToolTip="Periodically read selected global variable.">
                <Image Height="20" Source="/Resources/Icons/TimerIcon.png" />
            </ToggleButton>
            <Button Grid.Row="0" Grid.Column="3" Margin="4,0,0,4"
                                Click="ReadGlobal_Click" Padding="0"
                                ToolTip="Read selected global variable.">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowLivePosition}" Value="True" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                    <Condition Binding="{Binding DoGlobalReadAutoRefresh}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image Height="20" Source="/Resources/Icons/RefreshIcon.png" />
            </Button>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GlobalsFindSelectedItem.Name}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Value:" Style="{StaticResource tbHighlight}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GlobalsFindSelectedItem.Value}" Style="{StaticResource tbHighlight}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Value:" />
            <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GlobalsFindSelectedItem.LastValue}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Read At:" />
            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GlobalsFindSelectedItem.LastReadAt}" />

            <Border Grid.Row="5" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="#707070" Margin="0,0,0,2" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Message:" />
            <TextBlock Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GlobalReadMessage}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Set Value:" Margin="0" />
            <TextBox Grid.Row="7" Grid.Column="2" x:Name="txtGlobalSetValue" Margin="0" />
            <Button Grid.Row="7" Grid.Column="3" Margin="4,0,0,0" Click="WriteGlobal_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowLivePosition}" Value="True" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image Margin="0" Height="14" Source="/Resources/Icons/LivePositionIcon.png" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
